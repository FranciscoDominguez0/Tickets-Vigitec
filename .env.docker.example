APP_NAME="Sistema de Tickets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088

LOG_CHANNEL=stack
LOG_LEVEL=info

# Puertos alejados de Docker para evitar colisiones
APP_PORT=8088
DB_PORT_EXTERNAL=33068

# Base de datos en Docker
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tickets_laravel
DB_USERNAME=tickets_user
DB_PASSWORD=secret_password_aqui
DB_ROOT_PASSWORD=secret_root_password_aqui

# Sesiones, colas y caché
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Opciones de arranque Docker
RUN_MIGRATIONS=true
RUN_SEEDERS=false

